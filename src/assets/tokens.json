  "shadow": {
    "$type": "shadow",
    "$description": "Schatten-Rezepte. Die Farbe verweist auf das Light-Set; der Dark-Wert steht in $extensions.com.kodinitools.modes.dark.",
    "card-hover": {
      "$value": {
        "color": "{color.light.shadow.soft}",
        "offsetX": "0px",
        "offsetY": "12px",
        "blur": "40px",
        "spread": "0px"
      },
      "$description": "feature-card:hover, zusammen mit translateY(-4px)",
      "$extensions": {
        "com.kodinitools": { "modes": { "dark": { "color": "{color.dark.shadow.soft}" } } }
      }
    },
    "strip": {
      "$value": {
        "color": "{color.light.shadow.soft}",
        "offsetX": "0px",
        "offsetY": "6px",
        "blur": "24px",
        "spread": "0px"
      },
      "$description": "palette-strip",
      "$extensions": {
        "com.kodinitools": { "modes": { "dark": { "color": "{color.dark.shadow.soft}" } } }
      }
    },
    "float": {
      "$value": {
        "color": "{color.light.shadow.medium}",
        "offsetX": "0px",
        "offsetY": "4px",
        "blur": "20px",
        "spread": "0px"
      },
      "$description": "toast, color-tooltip, pixel-zoom",
      "$extensions": {
        "com.kodinitools": { "modes": { "dark": { "color": "{color.dark.shadow.medium}" } } }
      }
    },
    "showcase": {
      "$value": {
        "color": "{color.light.shadow.medium}",
        "offsetX": "0px",
        "offsetY": "20px",
        "blur": "60px",
        "spread": "0px"
      },
      "$description": "showcase-image-link",
      "$extensions": {
        "com.kodinitools": { "modes": { "dark": { "color": "{color.dark.shadow.medium}" } } }
      }
    },
    "indicator": {
      "$value": [
        {
          "color": "{color.light.shadow.medium}",
          "offsetX": "0px",
          "offsetY": "2px",
          "blur": "8px",
          "spread": "0px"
        },
        {
          "color": "{color.light.shadow.soft}",
          "offsetX": "0px",
          "offsetY": "0px",
          "blur": "0px",
          "spread": "1px"
        }
      ],
      "$description": "color-indicator; Hover 0 4px 12px",
      "$extensions": {
        "com.kodinitools": {
          "modes": {
            "dark": { "color": ["{color.dark.shadow.medium}", "{color.dark.shadow.soft}"] }
          }
        }
      }
    },
    "indicator-selected": {
      "$value": [
        {
          "color": "{color.light.selection.glow}",
          "offsetX": "0px",
          "offsetY": "0px",
          "blur": "0px",
          "spread": "3px"
        },
        {
          "color": "{color.light.shadow.medium}",
          "offsetX": "0px",
          "offsetY": "4px",
          "blur": "12px",
          "spread": "0px"
        }
      ],
      "$description": "color-indicator.selected, pulsiert 1.5 s",
      "$extensions": {
        "com.kodinitools": {
          "modes": {
            "dark": { "color": ["{color.dark.selection.glow}", "{color.dark.shadow.medium}"] }
          }
        }
      }
    },
    "focus-ring": {
      "$value": {
        "color": "{color.light.selection.glow}",
        "offsetX": "0px",
        "offsetY": "0px",
        "blur": "0px",
        "spread": "3px"
      },
      "$description": "field-select:focus, slider-field__range:focus-visible, upload-area.dragging, sample-thumbnail.selected",
      "$extensions": {
        "com.kodinitools": { "modes": { "dark": { "color": "{color.dark.selection.glow}" } } }
      }
    },
    "selection-ring": {
      "$value": {
        "color": "{color.light.selection.glow}",
        "offsetX": "0px",
        "offsetY": "0px",
        "blur": "0px",
        "spread": "2px"
      },
      "$description": "color-item.selected",
      "$extensions": {
        "com.kodinitools": { "modes": { "dark": { "color": "{color.dark.selection.glow}" } } }
      }
    },
    "thumb": {
      "$value": {
        "color": "rgba(0, 0, 0, 0.3)",
        "offsetX": "0px",
        "offsetY": "1px",
        "blur": "3px",
        "spread": "0px"
      },
      "$description": "Slider-Thumb, in beiden Themes gleich"
    },
    "modal": {
      "$value": {
        "color": "rgba(0, 0, 0, 0.5)",
        "offsetX": "0px",
        "offsetY": "25px",
        "blur": "50px",
        "spread": "-12px"
      },
      "$description": "modal-content über dem Overlay"
    },
    "handle": {
      "$value": {
        "color": "rgba(0, 0, 0, 0.3)",
        "offsetX": "0px",
        "offsetY": "2px",
        "blur": "10px",
        "spread": "0px"
      },
      "$description": "slider-handle im Vergleichsmodal"
    },
    "gallery-hover": {
      "$value": {
        "color": "rgba(0, 0, 0, 0.08)",
        "offsetX": "0px",
        "offsetY": "4px",
        "blur": "16px",
        "spread": "0px"
      },
      "$description": "gallery-item:hover"
    }
  },

  "motion": {
    "duration": {
      "$type": "duration",
      "fast": {
        "$value": "150ms",
        "$description": "Thumb-Scale, Spinner-Fokus, Reset-Farbe, Tooltip-Einblendung, Indikator-Transform"
      },
      "base": {
        "$value": "200ms",
        "$description": "Standard für Hover (transition: all), Toast-Ausblendung"
      },
      "modal": { "$value": "250ms", "$description": "Modal: Opacity und scale 0.95 → 1" },
      "theme": {
        "$value": "300ms",
        "$description": "Themewechsel auf background, color, border-color; Toast-Einblendung; Feature-Card-Hover"
      },
      "swatch": { "$value": "350ms", "$description": "Farbwechsel im PaletteStrip" },
      "tooltip-out": { "$value": "100ms" },
      "spin": {
        "$value": "1000ms",
        "$description": "Lade-Spinner in der Upload-Fläche, linear, endlos"
      },
      "pulse-selected": {
        "$value": "1500ms",
        "$description": "Puls des ausgewählten Indikators, endlos"
      },
      "pulse": {
        "$value": "2000ms",
        "$description": "Puls der Indikatoren, endlos; beim Ziehen aus"
      }
    },
    "easing": {
      "$type": "cubicBezier",
      "ease": { "$value": [0.25, 0.1, 0.25, 1], "$description": "CSS ease, Standard" },
      "ease-in": { "$value": [0.42, 0, 1, 1], "$description": "Toast- und Tooltip-Ausblendung" },
      "ease-out": { "$value": [0, 0, 0.58, 1], "$description": "Toast- und Tooltip-Einblendung" },
      "ease-in-out": { "$value": [0.42, 0, 0.58, 1], "$description": "Puls der Indikatoren" },
      "linear": { "$value": [0, 0, 1, 1], "$description": "Lade-Spinner" }
    },
    "transition": {
      "$type": "transition",
      "hover": {
        "$value": {
          "duration": "{motion.duration.base}",
          "delay": "0ms",
          "timingFunction": "{motion.easing.ease}"
        },
        "$description": "transition: all 0.2s ease"
      },
      "theme": {
        "$value": {
          "duration": "{motion.duration.theme}",
          "delay": "0ms",
          "timingFunction": "{motion.easing.ease}"
        },
        "$description": "transition: background 0.3s ease, color 0.3s ease"
      },
      "micro": {
        "$value": {
          "duration": "{motion.duration.fast}",
          "delay": "0ms",
          "timingFunction": "{motion.easing.ease}"
        },
        "$description": "transform 0.15s ease auf Thumb und Indikator"
      }
    },
    "lift": {
      "$type": "dimension",
      "$description": "translateY beim Hover",
      "subtle": { "$value": "-1px", "$description": "upload-area" },
      "button": {
        "$value": "-2px",
        "$description": "hero-cta, showcase-cta, cta-button, gallery-item"
      },
      "card": {
        "$value": "-4px",
        "$description": "feature-card, showcase-image-link; Toast nach links"
      }
    },
    "scale": {
      "$type": "number",
      "sample": { "$value": 1.05, "$description": "sample-thumbnail:hover" },
      "indicator-selected": { "$value": 1.1, "$description": "color-indicator.selected" },
      "dot": { "$value": 1.12, "$description": "scope-dot:hover und aktiv" },
      "thumb": { "$value": 1.15, "$description": "Slider-Thumb:hover, color-indicator:hover" },
      "dragging": { "$value": 1.2, "$description": "color-indicator.dragging" },
      "modal-enter": { "$value": 0.95, "$description": "modal-content beim Einblenden" }
    }
  },

  "opacity": {
    "$type": "number",
    "disabled": { "$value": 0.35, "$description": "btn-history, slider-field__reset, export-btn" },
    "disabled-arrow": { "$value": 0.3, "$description": "spin-arrow" },
    "disabled-slider": { "$value": 0.55, "$description": "slider-control--disabled" },
    "disabled-spinner": { "$value": 0.6, "$description": "spin--disabled" },
    "locked": { "$value": 0.4, "$description": "scope-dot--locked, empty-icon" },
    "unavailable": { "$value": 0.5, "$description": "sample-thumbnail.not-available" },
    "highlight-text": {
