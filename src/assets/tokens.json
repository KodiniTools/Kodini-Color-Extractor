{
  "$description": "Design Tokens des Kodini Color Extractor im Format der Design Tokens Community Group (DTCG). Farben, Schrift, Abstände, Radien, Schatten, Bewegung und Layout-Maße, wie sie in src/assets/main.css und den scoped Styles der Vue-Komponenten verwendet werden. Jeder Token mit einer CSS-Variable in $extensions wird von src/__tests__/tokens.test.ts gegen main.css geprüft.",
  "$extensions": {
    "com.kodinitools": {
      "version": 1,
      "source": "src/assets/main.css",
      "themes": {
        "light": ":root",
        "dark": "[data-theme='dark']"
      },
      "referenceSyntax": "{gruppe.pfad.token} verweist auf einen anderen Token dieser Datei"
    }
  },

  "color": {
    "$type": "color",

    "brand": {
      "$description": "Markenkonstanten, in beiden Themes gleich. Die Theme-Sets unten leiten sich daraus ab.",
      "accent": {
        "$value": "#c9984d",
        "$description": "Alias von color.brand.gold",
        "$extensions": { "com.kodinitools": { "cssVariable": "--color-accent" } }
      },
      "gold": {
        "$value": "#c9984d",
        "$description": "Akzent: Upload-Fläche, Rahmen, Highlight-Karte, Tag",
        "$extensions": { "com.kodinitools": { "cssVariable": "--color-1" } }
      },
      "blue": {
        "$value": "#014f99",
        "$description": "Primärbutton, Sekundärtext, Auswahl (Light)",
        "$extensions": { "com.kodinitools": { "cssVariable": "--color-2" } }
      },
      "navy": {
        "$value": "#003971",
        "$description": "Primärtext (Light), Text auf Akzent",
        "$extensions": { "com.kodinitools": { "cssVariable": "--color-3" } }
      },
      "gold-light": {
        "$value": "#f8e1a9",
        "$description": "Hairlines, Sekundärbutton (Light); Sekundärtext (Dark)",
        "$extensions": { "com.kodinitools": { "cssVariable": "--color-4" } }
      },
      "cream-light": {
        "$value": "#f9f2d5",
        "$description": "Primärtext im Dark Theme",
        "$extensions": { "com.kodinitools": { "cssVariable": "--color-5" } }
      }
    },

    "light": {
      "$description": "Semantische Farben, Light Theme (:root in main.css)",
      "bg": {
        "primary": {
          "$value": "#f5f4d6",
          "$description": "Seitengrund, Landing, Canvas-Platzhalter, Detail-Karten",
          "$extensions": { "com.kodinitools": { "cssVariable": "--bg-primary" } }
        },
        "secondary": {
          "$value": "#ffffff",
          "$description": "Workspace-Mitte, Karten, Farbliste, Toast, Tooltip",
          "$extensions": { "com.kodinitools": { "cssVariable": "--bg-secondary" } }
        },
        "sidebar": {
          "$type": "gradient",
          "$value": [
            { "color": "#f5f4d6", "position": 0 },
            { "color": "#ece6b5", "position": 1 }
          ],
          "$description": "Verlauf 180° für Sidebar, Edit-Panel, Modal, Galerie-Karten",
          "$extensions": {
            "com.kodinitools": {
              "cssVariable": "--bg-sidebar",
              "css": "linear-gradient(180deg, #f5f4d6 0%, #ece6b5 100%)",
              "angle": 180
            }
          }
        },
        "input": {
          "$value": "#ffffff",
          "$description": "Selects, Export-Buttons, Spinner, Pills, Reset-Knopf",
          "$extensions": { "com.kodinitools": { "cssVariable": "--bg-input" } }
        },
        "hover": {
          "$value": "#ece8c0",
          "$description": "Hover auf Nav-Links, Karten, Buttons; aktiver Nav-Link; Drop-Zustand",
          "$extensions": { "com.kodinitools": { "cssVariable": "--bg-hover" } }
        }
      },
      "text": {
        "primary": {
          "$value": "#003971",
          "$description": "Überschriften, Werte, Panel-Titel, Button-Text auf hellem Grund",
          "$extensions": { "com.kodinitools": { "cssVariable": "--text-primary" } }
        },
        "secondary": {
          "$value": "#014f99",
          "$description": "Fließtext, Labels, Nav-Links, Hinweise",
          "$extensions": { "com.kodinitools": { "cssVariable": "--text-secondary" } }
        },
        "tertiary": {
          "$value": "#7a8fa5",
          "$description": "Sektions-Labels, Captions, Icons, Platzhalter. Kontrast auf Weiß 3,3:1, unter 4,5:1 für kleinen Text",
          "$extensions": { "com.kodinitools": { "cssVariable": "--text-tertiary" } }
        },
        "on-accent": {
          "$value": "#003971",
          "$description": "Deklariert, in keiner Komponente verwendet (accent.text übernimmt)",
          "$extensions": { "com.kodinitools": { "cssVariable": "--text-on-accent" } }
        }
      },
      "border": {
        "default": {
          "$value": "#c9984d",
          "$description": "Controls, Export-Buttons, Dropzone, Toast, Tooltip",
          "$extensions": { "com.kodinitools": { "cssVariable": "--border-color" } }
        },
        "light": {
          "$value": "#f8e1a9",
          "$description": "Hairlines: Panel-Trenner, Sektionen, Karten, Nav-Unterkante",
          "$extensions": { "com.kodinitools": { "cssVariable": "--border-light" } }
        },
        "hover": {
          "$value": "#014f99",
          "$description": "Hover-Rahmen auf Controls, Karten, Pills",
          "$extensions": { "com.kodinitools": { "cssVariable": "--border-hover" } }
        }
      },
      "button": {
        "primary": {
          "bg": {
            "$value": "#014f99",
            "$description": "Hero-CTA, Showcase-CTA, Export primär, aktive Pills, Zähler-Badge",
            "$extensions": { "com.kodinitools": { "cssVariable": "--btn-primary-bg" } }
          },
          "hover": {
            "$value": "#003971",
            "$extensions": { "com.kodinitools": { "cssVariable": "--btn-primary-hover" } }
          },
          "text": {
            "$value": "#f5f4d6",
            "$description": "Kontrast auf button.primary.bg 7,3:1",
            "$extensions": { "com.kodinitools": { "cssVariable": "--btn-primary-text" } }
          }
        },
        "secondary": {
          "bg": {
            "$value": "#f8e1a9",
            "$description": "Icon-Buttons im Panel-Header (Vorschau, Löschen, Schließen), Copy-Hover",
            "$extensions": { "com.kodinitools": { "cssVariable": "--btn-secondary-bg" } }
          },
          "hover": {
            "$value": "#c9984d",
            "$description": "Hover des Schließen-Buttons im Modal",
            "$extensions": { "com.kodinitools": { "cssVariable": "--btn-secondary-hover" } }
          },
          "text": {
            "$value": "#003971",
            "$extensions": { "com.kodinitools": { "cssVariable": "--btn-secondary-text" } }
          }
        }
      },
      "accent": {
        "bg": {
          "$value": "#c9984d",
          "$description": "Upload-Fläche, Highlight-Karte, Tag, Erfolgs-Toast, Listen-Punkte, Reset-Hover",
          "$extensions": { "com.kodinitools": { "cssVariable": "--accent-bg" } }
        },
        "hover": {
          "$value": "#b5873f",
          "$description": "Hover von Upload-Fläche und Akzent-CTA; Rahmen des Erfolgs-Toasts",
          "$extensions": { "com.kodinitools": { "cssVariable": "--accent-hover" } }
        },
        "text": {
          "$value": "#003971",
          "$description": "Text auf Gold. Kontrast 4,4:1, erst ab 18 px oder 14 px fett sicher",
          "$extensions": { "com.kodinitools": { "cssVariable": "--accent-text" } }
        }
      },
      "selection": {
        "color": {
          "$value": "#014f99",
          "$description": "Ausgewählte Farbkarte, Indikator, FAQ offen, Fokus-Rahmen, Sample-Hover",
          "$extensions": { "com.kodinitools": { "cssVariable": "--selection-color" } }
        },
        "glow": {
          "$value": "rgba(1, 79, 153, 0.2)",
          "$description": "Fokusring 3 px, Auswahlring 2 px, Puls des Indikators",
          "$extensions": { "com.kodinitools": { "cssVariable": "--selection-glow" } }
        }
      },
      "shadow": {
        "soft": {
          "$value": "rgba(0, 57, 113, 0.08)",
          "$description": "Schattenfarbe für Karten-Hover, Palettenstreifen, Indikator-Ring",
          "$extensions": { "com.kodinitools": { "cssVariable": "--shadow-soft" } }
        },
        "medium": {
          "$value": "rgba(0, 57, 113, 0.12)",
          "$description": "Schattenfarbe für Toast, Tooltip, Lupe, Showcase-Bild, Indikator",
          "$extensions": { "com.kodinitools": { "cssVariable": "--shadow-medium" } }
        }
      },
      "slider": {
        "track-from": {
          "$value": "#7a8fa5",
          "$extensions": { "com.kodinitools": { "cssVariable": "--slider-track-from" } }
        },
        "track-to": {
          "$value": "#c9984d",
          "$extensions": { "com.kodinitools": { "cssVariable": "--slider-track-to" } }
        },
        "thumb": {
          "$value": "#c9984d",
          "$extensions": { "com.kodinitools": { "cssVariable": "--slider-thumb" } }
        }
      },
      "status": {
        "$description": "Hartkodiert in ToastContainer.vue, keine CSS-Variable",
        "error": {
          "bg": { "$value": "#fee2e2" },
          "text": { "$value": "#991b1b" },
          "border": { "$value": "#fecaca" }
        }
      }
    },

    "dark": {
      "$description": "Semantische Farben, Dark Theme ([data-theme='dark'] in main.css)",
      "bg": {
        "primary": {
          "$value": "#1a1a2e",
          "$extensions": { "com.kodinitools": { "cssVariable": "--bg-primary" } }
        },
        "secondary": {
          "$value": "#16213e",
          "$extensions": { "com.kodinitools": { "cssVariable": "--bg-secondary" } }
        },
        "sidebar": {
          "$type": "gradient",
          "$value": [
            { "color": "#1a1a2e", "position": 0 },
            { "color": "#16213e", "position": 1 }
          ],
          "$extensions": {
            "com.kodinitools": {
              "cssVariable": "--bg-sidebar",
              "css": "linear-gradient(180deg, #1a1a2e 0%, #16213e 100%)",
              "angle": 180
            }
          }
        },
        "input": {
          "$value": "#16213e",
          "$extensions": { "com.kodinitools": { "cssVariable": "--bg-input" } }
        },
        "hover": {
          "$value": "#1f2b47",
          "$extensions": { "com.kodinitools": { "cssVariable": "--bg-hover" } }
        }
      },
      "text": {
        "primary": {
          "$value": "#f9f2d5",
          "$extensions": { "com.kodinitools": { "cssVariable": "--text-primary" } }
        },
        "secondary": {
          "$value": "#f8e1a9",
          "$extensions": { "com.kodinitools": { "cssVariable": "--text-secondary" } }
        },
        "tertiary": {
          "$value": "#7a8fa5",
          "$description": "Kontrast auf bg.secondary 4,8:1",
          "$extensions": { "com.kodinitools": { "cssVariable": "--text-tertiary" } }
        },
        "on-accent": {
          "$value": "#003971",
          "$extensions": { "com.kodinitools": { "cssVariable": "--text-on-accent" } }
        }
      },
      "border": {
        "default": {
          "$value": "#014f99",
          "$extensions": { "com.kodinitools": { "cssVariable": "--border-color" } }
        },
        "light": {
          "$value": "#1f2b47",
          "$extensions": { "com.kodinitools": { "cssVariable": "--border-light" } }
        },
        "hover": {
          "$value": "#c9984d",
          "$extensions": { "com.kodinitools": { "cssVariable": "--border-hover" } }
        }
      },
      "button": {
        "primary": {
          "bg": {
            "$value": "#c9984d",
            "$extensions": { "com.kodinitools": { "cssVariable": "--btn-primary-bg" } }
          },
          "hover": {
            "$value": "#f8e1a9",
            "$extensions": { "com.kodinitools": { "cssVariable": "--btn-primary-hover" } }
          },
          "text": {
            "$value": "#003971",
            "$description": "Kontrast auf button.primary.bg 4,4:1",
            "$extensions": { "com.kodinitools": { "cssVariable": "--btn-primary-text" } }
          }
        },
        "secondary": {
          "bg": {
            "$value": "#1f2b47",
            "$extensions": { "com.kodinitools": { "cssVariable": "--btn-secondary-bg" } }
          },
          "hover": {
            "$value": "#014f99",
            "$extensions": { "com.kodinitools": { "cssVariable": "--btn-secondary-hover" } }
          },
          "text": {
            "$value": "#f9f2d5",
            "$extensions": { "com.kodinitools": { "cssVariable": "--btn-secondary-text" } }
          }
        }
      },
      "accent": {
        "bg": {
          "$value": "#c9984d",
          "$extensions": { "com.kodinitools": { "cssVariable": "--accent-bg" } }
        },
        "hover": {
          "$value": "#f8e1a9",
          "$extensions": { "com.kodinitools": { "cssVariable": "--accent-hover" } }
        },
        "text": {
          "$value": "#003971",
          "$extensions": { "com.kodinitools": { "cssVariable": "--accent-text" } }
        }
      },
      "selection": {
        "color": {
          "$value": "#c9984d",
          "$extensions": { "com.kodinitools": { "cssVariable": "--selection-color" } }
        },
        "glow": {
          "$value": "rgba(201, 152, 77, 0.25)",
          "$extensions": { "com.kodinitools": { "cssVariable": "--selection-glow" } }
        }
      },
      "shadow": {
        "soft": {
          "$value": "rgba(0, 0, 0, 0.3)",
          "$extensions": { "com.kodinitools": { "cssVariable": "--shadow-soft" } }
        },
        "medium": {
          "$value": "rgba(0, 0, 0, 0.4)",
          "$extensions": { "com.kodinitools": { "cssVariable": "--shadow-medium" } }
        }
      },
      "slider": {
        "track-from": {
          "$value": "#7a8fa5",
          "$extensions": { "com.kodinitools": { "cssVariable": "--slider-track-from" } }
        },
        "track-to": {
          "$value": "#c9984d",
          "$extensions": { "com.kodinitools": { "cssVariable": "--slider-track-to" } }
        },
        "thumb": {
          "$value": "#f8e1a9",
          "$extensions": { "com.kodinitools": { "cssVariable": "--slider-thumb" } }
        }
      },
      "status": {
        "$description": "Hartkodiert in ToastContainer.vue unter [data-theme='dark'] .toast.error",
        "error": {
          "bg": { "$value": "#450a0a" },
          "text": { "$value": "#fecaca" },
          "border": { "$value": "#7f1d1d" }
        }
      }
    },

    "static": {
      "$description": "Theme-unabhängige, hartkodierte Farben aus den Komponenten",
      "white": {
        "$value": "#ffffff",
        "$description": "Indikator-Rand 3 px, Lupen-Rand 3 px, Thumb-Rand 2 px, Vergleichs-Griff und -Linie, Swatch-Text auf dunklen Farben"
      },
      "danger": {
        "$value": "#ef4444",
        "$description": "delete-btn:hover in ImageEditPanel.vue, Text weiß"
      },
      "donate-hover": {
        "$value": "#0070ba",
        "$description": "Markenblau des Zahlungsdienstes auf donate-btn:hover in AppPage.vue"
      },
      "swatch-text-dark": {
        "$value": "#1a1a2e",
        "$description": "swatch--light im PaletteStrip: Label auf hellen Palettenfarben"
      },
      "swatch-ring-inner": {
        "$value": "rgba(17, 17, 17, 0.85)",
        "$description": "swatch--selected: innerer Ring (inset 6 px) hinter dem weißen Ring (inset 3 px)"
      },
      "swatch-action-bg": {
        "$value": "rgba(127, 127, 127, 0.22)",
        "$description": "Lock-Button und Hex-Label-Hover auf jeder Swatch-Farbe (.18 beim Hex-Label)"
      },
      "overlay": {
        "$value": "rgba(0, 0, 0, 0.8)",
        "$description": "Modal-Hintergrund"
      },
      "image-label-bg": {
        "$value": "rgba(0, 0, 0, 0.7)",
        "$description": "Vorher/Nachher-Label im Vergleichsmodal"
      },
      "handle-icon": {
        "$value": "#333333",
        "$description": "Pfeile im weißen Vergleichs-Griff"
      }
    }
  },

  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Supreme", "sans-serif"],
        "$description": "Primärschrift. @font-face lädt nur Supreme-Regular.woff2 (400) von /fonts/ der Website; 500 bis 700 werden synthetisiert."
      },
      "mono": {
        "$value": ["Courier New", "monospace"],
        "$description": "Nur im NumberSpinner (Wert und Einheit)"
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400, "$description": "Fließtext, Captions" },
      "medium": { "$value": 500, "$description": "Labels, Nav-Links, Toast, FAQ-Frage" },
      "semibold": { "$value": 600, "$description": "Buttons, Titel, Werte" },
      "bold": { "$value": 700, "$description": "Hero, H2, Caps-Labels, Zähler-Badge" }
    },
    "size": {
      "$type": "dimension",
      "9-5": { "$value": "9.5px", "$description": "btn-history, kleinste Textgröße" },
      "10": { "$value": "10px", "$description": "slider-control__label" },
      "11": {
        "$value": "11px",
        "$description": "panel-section-title, color-secondary, tooltip-hint, gallery-item-size"
      },
      "12": { "$value": "12px", "$description": "sidebar-note, scope-count, image-label" },
      "13": {
        "$value": "13px",
        "$description": "field-row label, field-select, sidebar-hint, color-primary, export-btn, scope-tab"
      },
      "14": {
        "$value": "14px",
        "$description": "toast, nav-link, feature-description, faq-answer, placeholder-hint"
      },
      "15": {
        "$value": "15px",
        "$description": "hero-cta, cta-button, faq-question, showcase-list, detail-item h4"
      },
      "16": {
        "$value": "16px",
        "$description": "panel-title, header-title, showcase-desc, details-subtitle"
      },
      "18": { "$value": "18px", "$description": "feature-title, modal-title, placeholder-text" },
      "22": { "$value": "22px", "$description": "faq-cta h2" },
      "28": { "$value": "28px", "$description": "cta-content h2 (clamp-Maximum)" },
      "32": {
        "$value": "32px",
        "$description": "details-title (clamp-Maximum), hero-title (clamp-Minimum)"
      },
      "34": { "$value": "34px", "$description": "showcase-title (clamp-Maximum)" },
      "40": { "$value": "40px", "$description": "faq-title (clamp-Maximum)" },
      "48": { "$value": "48px", "$description": "hero-title (clamp-Maximum)" },
      "spinner": {
        "$value": "0.66rem",
        "$description": "spin-input; ab 768 px abwärts 0.75rem"
      },
      "spinner-unit": { "$value": "0.6rem", "$description": "spin-unit" },
      "reset-glyph": {
        "$value": "0.8rem",
        "$description": "slider-field__reset; ab 768 px abwärts 0.95rem"
      },
      "fluid": {
        "$description": "Titel skalieren per clamp(); $value ist der Desktop-Wert (Maximum)",
        "hero-title": {
          "$value": "48px",
          "$extensions": {
            "com.kodinitools": {
              "css": "clamp(32px, 5vw, 48px)",
              "min": "32px",
              "preferred": "5vw",
              "max": "48px"
            }
          }
        },
        "faq-title": {
          "$value": "40px",
          "$extensions": {
            "com.kodinitools": {
              "css": "clamp(28px, 4vw, 40px)",
              "min": "28px",
              "preferred": "4vw",
              "max": "40px"
            }
          }
        },
        "showcase-title": {
          "$value": "34px",
          "$extensions": {
            "com.kodinitools": {
              "css": "clamp(24px, 3.5vw, 34px)",
              "min": "24px",
              "preferred": "3.5vw",
              "max": "34px"
            }
          }
        },
        "details-title": {
          "$value": "32px",
          "$extensions": {
            "com.kodinitools": {
              "css": "clamp(24px, 4vw, 32px)",
              "min": "24px",
              "preferred": "4vw",
              "max": "32px"
            }
          }
        },
        "cta-title": {
          "$value": "28px",
          "$extensions": {
            "com.kodinitools": {
              "css": "clamp(22px, 3vw, 28px)",
              "min": "22px",
              "preferred": "3vw",
              "max": "28px"
            }
          }
        },
        "hero-subtitle": {
          "$value": "18px",
          "$extensions": {
            "com.kodinitools": {
              "css": "clamp(16px, 2vw, 18px)",
              "min": "16px",
              "preferred": "2vw",
              "max": "18px"
            }
          }
        },
        "swatch-label": {
          "$value": "18px",
          "$extensions": {
            "com.kodinitools": {
              "css": "clamp(14px, 1.4vw, 18px)",
              "min": "14px",
              "preferred": "1.4vw",
              "max": "18px"
            }
          }
        },
        "swatch-label-long": {
          "$value": "13px",
          "$description": "CSS-, SCSS- und Tailwind-Labels im PaletteStrip",
          "$extensions": {
            "com.kodinitools": {
              "css": "clamp(11px, 0.85vw, 13px)",
              "min": "11px",
              "preferred": "0.85vw",
              "max": "13px"
            }
          }
        }
      }
    },
    "letter-spacing": {
      "$type": "dimension",
      "none": { "$value": "0px" },
      "tight": { "$value": "0.02em", "$description": "swatch-hex--long" },
      "history": { "$value": "0.03em", "$description": "btn-history" },
      "hex": { "$value": "0.04em", "$description": "adjust-picker-hex" },
      "label": { "$value": "0.06em", "$description": "slider-control__label, swatch-hex" },
      "section": { "$value": "0.09em", "$description": "panel-section-title" },
      "image-label": { "$value": "0.5px", "$description": "Vorher/Nachher-Label im Modal" }
    },
    "line-height": {
      "$type": "number",
      "heading": { "$value": 1.2, "$description": "hero-title, showcase-title" },
      "control": { "$value": 1.3, "$description": "spin-input" },
      "hint": { "$value": 1.45, "$description": "sidebar-hint" },
      "body": {
        "$value": 1.5,
        "$description": "feature-description, showcase-list, detail-item p"
      },
      "relaxed": { "$value": 1.6, "$description": "hero-subtitle, showcase-desc, faq-answer" }
    }
  },

  "typography": {
    "$type": "typography",
